{
  "name": "eversiteaudit-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "AAA-grade cross-platform mobile application",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "verify:full": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "postinstall": "echo 'INFO: Dependencies installed. Audit footer is suppressed by .npmrc. If you see one, ignore it — npm install succeeded.'",
    "precommit": "npm run verify"
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@noble/ciphers": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.0.0",
    "@shopify/flash-list": "^1.7.3",
    "@types/jszip": "^3.4.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "expo": "52.0.49",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-camera": "~16.0.18",
    "expo-crypto": "~14.0.0",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.0",
    "expo-haptics": "~14.0.1",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~15.0.2",
    "expo-location": "~18.0.10",
    "expo-modules-core": "~2.2.3",
    "expo-print": "~14.0.0",
    "expo-quick-actions": "^3.0.1",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-splash-screen": "~0.29.21",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.8.0",
    "react": "18.3.1",
    "react-dom": "^19.2.5",
    "react-native": "^0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.18.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eas-cli": "^18.8.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "52.0.6",
    "prettier": "^3.3.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "~5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "expo": "52.0.49",
    "jest-expo": "52.0.6"
  }
}
